{
  "name": "zivopo-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "services/api"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix services/api run start:dev",
    "install:web": "npm --prefix apps/web install",
    "install:api": "npm --prefix services/api install"
  }
}
